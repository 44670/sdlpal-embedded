# M5Stack Cardputer ADV extreme profile: 8MB flash, internal SRAM only.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y

CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHMODE="dio"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_cardputer_extreme.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_cardputer_extreme.csv"

CONFIG_SPIRAM=n

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# Match the Cardputer ADV vendor demo's clock/tick timing.  The engine's
# SDL_Delay(1) polling loops require a 1ms RTOS tick, and the indexed scaler
# plus battle renderer benefit from the supported 240MHz CPU setting.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The full engine currently runs on app_main.  Measure its high-water mark
# on hardware before attempting to reduce this further.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# The no-audio extreme profile has no useful second-core worker.  Unicore
# avoids reserving a second idle-task stack and scheduler state from the
# already narrow internal-RAM margin.
CONFIG_FREERTOS_UNICORE=y

CONFIG_FATFS_VOLUME_COUNT=1
CONFIG_FATFS_LFN_NONE=y
CONFIG_FATFS_SECTOR_512=y
CONFIG_FATFS_FS_LOCK=0
CONFIG_FATFS_PER_FILE_CACHE=n
CONFIG_FATFS_USE_FASTSEEK=n
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=0
CONFIG_FATFS_USE_DYN_BUFFERS=n
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=n
CONFIG_FATFS_ALLOC_PREFER_ALIGNED_WORK_BUFFERS=n

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_NVS_ENABLED=n
