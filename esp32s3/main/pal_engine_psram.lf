    pal_engine_pack_provider (pal_engine_static_bss)
    res (pal_engine_static_bss)
    rngplay (pal_engine_static_bss)
    uigame (pal_engine_static_bss)
    video (pal_engine_static_bss)
    sdl_shim (pal_engine_static_bss)
